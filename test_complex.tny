{ test_complex.tny — 综合测试
  组合算术、比较、if、repeat、嵌套结构的完整测试 }

{ 输入三个数 }
read a;
read b;
read c;

{ 算术表达式 }
sum := a + b + c;
avg := sum / 3;
write sum;
write avg;

{ 找出最大值 }
max := a;
if b > max then max := b end;
if c > max then max := c end;
write max;

{ 判断三角形类型 }
if a + b > c then
  if a = b then
    if b = c then
      write 3
    else
      write 2
    end
  else
    write 1
  end
else
  write 0
end;

{ 计算 a 的 b 次方 }
result := 1;
count := 0;
repeat
  result := result * a;
  count := count + 1
until count = b;
write result
