{ test_for.tny — FOR 循环测试
  语法: FOR (初始化赋值 ; 条件 ; 步进) 循环体 END
  步进可使用: x := x+1  或  ++x / --x }

{ for 循环：计算 1+2+3+4+5 = 15 }
sum := 0;
for (i := 1; i <= 5; i := i + 1)
  sum := sum + i
end;
write sum;

{ for 循环：计算 5*4*3*2*1 = 120 }
fact := 1;
for (j := 5; j >= 1; j := j - 1)
  fact := fact * j
end;
write fact
